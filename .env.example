# Required — this is a generic ILIAS MCP server with no default, so it
# doesn't silently run against the wrong institution. Must match a
# registered provider name; run `ilias-mcp providers` to list them.
# Built-in: "kit"
ILIAS_PROVIDER=kit

# Base URL of the ILIAS instance. Has a sensible default per provider,
# override only if your institution uses a different ILIAS client_id/host.
# ILIAS_BASE_URL=https://ilias.studium.kit.edu

# Credentials for the "kit" provider (your KIT account, e.g. xy1234 or uxxxx).
# Recommended: leave these unset and run `ilias-mcp init` instead — it
# stores them in the OS keyring (macOS Keychain / Windows Credential
# Manager / Linux Secret Service) rather than as plaintext here. Only use
# these if you specifically need env-var/file-based credentials (e.g. CI).
KIT_USERNAME=
KIT_PASSWORD=

# Optional: where downloaded files are stored.
# ILIAS_MCP_DOWNLOAD_DIR=~/ILIAS
